# Frontend (Vite) — copy to .env.local
VITE_API_URL=
# Optional standby API (same database). Calls switch to it automatically when VITE_API_URL stops answering.
VITE_API_URL_FALLBACK=
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web). Add your site origin under "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=
# Local testing only: shows an email box that signs in without Google. Never set in production.
VITE_DEV_AUTH=

# Firebase (optional) — web app settings are public. Get them with: firebase apps:sdkconfig WEB <appId> --project <your-firebase-project>
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_SENDER_ID=
# Set to "firebase" ONLY after enabling the Google provider in the Firebase console (Authentication → Sign-in method).
VITE_AUTH_PROVIDER=
# Cloud Messaging → Web Push certificates → generate key pair; paste the public key here to enable browser push.
VITE_FIREBASE_VAPID_KEY=
