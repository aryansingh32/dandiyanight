# Postgres connection: Supabase pooler (transaction mode) or the VM standby.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Must match the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Comma-separated site origins allowed to call the API (e.g. https://dandiya.example.com). Empty = allow any (dev only).
CORS_ORIGIN=
# Local testing only: accepts "dev:<email>" instead of a Google token. Leave empty in production.
DEV_AUTH=
PORT=8787

# ── Payments ──
# Manual UPI-QR / cash payments need nothing here: the QR, cash room and timings are set in Admin → Settings.
# Optional backups of payment screenshots (Postgres always keeps the main copy):
#   Supabase Storage — private bucket `payment-proofs` (created by migration 014)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
#   Firebase Storage — also needs the Firebase service account
FIREBASE_STORAGE_BUCKET=
# Razorpay is retired. To bring it back set ENABLE_RAZORPAY=1 together with RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET.
ENABLE_RAZORPAY=
# Development only: re-enables the old "test checkout" that marks a payment paid without money. NEVER set in production.
DEMO_CHECKOUT=

# ── Firebase (Google sign-in, live chat, push) ──
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
# base64 of the service-account JSON (never commit the JSON itself)
FIREBASE_SERVICE_ACCOUNT_B64=

# ── Security ──
# Production: NODE_ENV=production refuses DEV_AUTH / DEMO_CHECKOUT and requires CORS_ORIGIN.
NODE_ENV=
# Number of reverse-proxy hops in front of the API (1 behind Railway/Cloudflare). Empty = trust no X-Forwarded-For.
TRUST_PROXY=
# Bad requests (401/403/404/400) per IP per minute before that IP is blocked for 10 minutes.
STRIKE_LIMIT=300
